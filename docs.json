{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Clemta",
  "colors": {
    "primary": "#2563EB",
    "light": "#2563EB",
    "dark": "#2563EB"
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "favicon": "favicon.svg",
  "navigation": {
    "products": [
      {
        "product": "Partner API",
        "description": "Offer company formation and services through Clemta, programmatically.",
        "icon": "handshake",
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Get Started",
                "pages": [
                  "partner/introduction",
                  "partner/quickstart",
                  "partner/authentication",
                  "partner/concepts"
                ]
              },
              {
                "group": "The platform",
                "pages": [
                  "partner/company-lifecycle",
                  "partner/requirements",
                  "partner/service-orders",
                  "partner/tax-filings",
                  "partner/files",
                  "partner/whitelabel",
                  "partner/embedding"
                ]
              },
              {
                "group": "Building on the API",
                "pages": [
                  "partner/list-queries",
                  "partner/idempotency",
                  "partner/rate-limiting",
                  "partner/webhooks",
                  "partner/errors"
                ]
              },
              {
                "group": "Versioning",
                "pages": [
                  "partner/versioning",
                  "partner/versions",
                  "partner/changelog",
                  "partner/openapi-specs"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "openapi": "partner/openapi.yaml",
            "groups": [
              {
                "group": "Identity",
                "pages": [
                  "GET /me"
                ]
              },
              {
                "group": "Accounts",
                "pages": [
                  "POST /accounts",
                  "GET /accounts",
                  "GET /accounts/{accountID}",
                  "POST /accounts/{accountID}"
                ]
              },
              {
                "group": "Companies",
                "pages": [
                  "POST /companies",
                  "GET /companies",
                  "GET /companies/{companyID}",
                  "POST /companies/{companyID}"
                ]
              },
              {
                "group": "Officers & directors",
                "pages": [
                  "GET /companies/{companyID}/officers",
                  "POST /companies/{companyID}/officers",
                  "POST /companies/{companyID}/officers/{officerID}",
                  "DELETE /companies/{companyID}/officers/{officerID}"
                ]
              },
              {
                "group": "Products and pricing",
                "pages": [
                  "GET /products",
                  "GET /products/{productKey}/price-preview",
                  "POST /companies/price-preview",
                  "GET /companies/{companyID}/products/{productKey}/price-preview"
                ]
              },
              {
                "group": "Service orders",
                "pages": [
                  "POST /companies/{companyID}/service-orders",
                  "GET /companies/{companyID}/service-orders",
                  "GET /companies/{companyID}/service-orders/{orderID}",
                  "POST /companies/{companyID}/service-orders/{orderID}",
                  "DELETE /companies/{companyID}/service-orders/{orderID}"
                ]
              },
              {
                "group": "Tax filings",
                "pages": [
                  "POST /companies/{companyID}/tax-filings",
                  "GET /companies/{companyID}/tax-filings",
                  "GET /companies/{companyID}/tax-filings/{filingID}",
                  "POST /companies/{companyID}/tax-filings/{filingID}",
                  "POST /companies/{companyID}/tax-filings/{filingID}/submit"
                ]
              },
              {
                "group": "Fixed assets",
                "pages": [
                  "GET /companies/{companyID}/fixed-assets",
                  "POST /companies/{companyID}/fixed-assets",
                  "GET /companies/{companyID}/fixed-assets/{fixedAssetID}",
                  "POST /companies/{companyID}/fixed-assets/{fixedAssetID}",
                  "DELETE /companies/{companyID}/fixed-assets/{fixedAssetID}"
                ]
              },
              {
                "group": "Requirements",
                "pages": [
                  "GET /requirements",
                  "GET /requirements/{requirementID}",
                  "POST /requirements/{requirementID}/fulfill"
                ]
              },
              {
                "group": "Verification and signing",
                "pages": [
                  "POST /companies/{companyID}/verification-sessions",
                  "POST /companies/{companyID}/signing-sessions",
                  "POST /companies/{companyID}/signature-signers"
                ]
              },
              {
                "group": "Files",
                "pages": [
                  "POST /files",
                  "GET /files",
                  "GET /files/{fileID}",
                  "GET /files/{fileID}/contents",
                  "GET /companies/{companyID}/files"
                ]
              },
              {
                "group": "File links",
                "pages": [
                  "POST /file-links",
                  "GET /file-links",
                  "GET /file-links/{linkID}",
                  "POST /file-links/{linkID}",
                  "GET /file-links/{token}/contents"
                ]
              },
              {
                "group": "Calendar",
                "pages": [
                  "GET /companies/{companyID}/calendar"
                ]
              },
              {
                "group": "Status tracking",
                "pages": [
                  "POST /companies/{companyID}/status-tokens",
                  "GET /companies/{companyID}/status-tokens",
                  "DELETE /companies/{companyID}/status-tokens/{tokenID}",
                  "GET /status/{token}"
                ]
              },
              {
                "group": "Events",
                "pages": [
                  "GET /events"
                ]
              },
              {
                "group": "Hosted links",
                "pages": [
                  "GET /requirement-links/{token}",
                  "PUT /requirement-links/{token}/document",
                  "GET /signing-links/{token}"
                ]
              },
              {
                "group": "Sandbox",
                "pages": [
                  "POST /sandbox/companies/{companyID}/simulate",
                  "GET /clock",
                  "POST /clock",
                  "POST /clock/advance",
                  "DELETE /clock"
                ]
              },
              {
                "group": "Webhook events",
                "pages": [
                  "webhook company.created",
                  "webhook company.status.changed",
                  "webhook company.verified",
                  "webhook company.incorporated",
                  "webhook company.onboarding.completed",
                  "webhook company.name.changed",
                  "webhook company.ein.assigned",
                  "webhook company.document.received",
                  "webhook company.dissolved",
                  "webhook company.updated",
                  "webhook company.entitlements.changed",
                  "webhook tax_filing.created",
                  "webhook tax_filing.status.changed",
                  "webhook service_order.status.changed",
                  "webhook service_order.completed",
                  "webhook service_order.updated",
                  "webhook service_order.quoted",
                  "webhook service_order.renewal_canceled",
                  "webhook service_order.renewal_cancel_denied",
                  "webhook requirement.created",
                  "webhook requirement.fulfilled",
                  "webhook requirement.canceled",
                  "webhook requirement.signature.viewed",
                  "webhook requirement.signature.signed",
                  "webhook file.created",
                  "webhook calendar.reminder",
                  "webhook invoice.finalized"
                ]
              }
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Partner Dashboard",
          "href": "https://partner.clemta.com",
          "icon": "gauge"
        },
        {
          "anchor": "Clemta.com",
          "href": "https://clemta.com",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Partner Dashboard",
      "href": "https://partner.clemta.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/clemta",
